# Supabase â€” safe public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://oeqvwqvfygkekghuthjq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY_HERE

# Supabase â€” server-only secret key (sb_secret_... preferred).
# Never add NEXT_PUBLIC_ to this variable and never commit the value.
SUPABASE_SECRET_KEY=PASTE_YOUR_SUPABASE_SECRET_KEY_HERE

# Only this Supabase Auth email is allowed into the admin dashboard.
ADMIN_EMAIL=donjoseph3000@gmail.com

# Site URL. Change to the deployed Vercel URL after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Web application client downloaded from Google Cloud Console.
GOOGLE_CLIENT_ID=PASTE_GOOGLE_OAUTH_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# Exact Google accounts allowed for each storage role.
GOOGLE_PHOTOS_ALLOWED_EMAIL=photosbaptism287@gmail.com
GOOGLE_VIDEOS_ALLOWED_EMAIL=videobaptism772@gmail.com

# Generate these locally. Do not reuse the same value for both.
# GOOGLE_TOKEN_ENCRYPTION_KEY: 32 random bytes encoded as base64 (44 chars).
GOOGLE_TOKEN_ENCRYPTION_KEY=GENERATE_A_32_BYTE_BASE64_KEY
GOOGLE_OAUTH_STATE_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RATE_LIMIT_HASH_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Limits are application safeguards, not Google Drive limits.
GUEST_JOIN_MAX_ATTEMPTS=12
MAX_PHOTO_UPLOAD_BYTES=104857600
MAX_VIDEO_UPLOAD_BYTES=1073741824

# Private original-media streaming gateway. Deploy cloudflare-media-proxy first,
# then set MEDIA_PROXY_BASE_URL to its /media endpoint. These two secrets must
# also be configured as Cloudflare Worker secrets (never expose them to clients).
MEDIA_PROXY_BASE_URL=
MEDIA_PROXY_SIGNING_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MEDIA_PROXY_SHARED_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MEDIA_PROXY_TOKEN_TTL_SECONDS=43200
